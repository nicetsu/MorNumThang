// Mor Num Thang — data model. See PLAN.md §3.
// ponytail: SQLite until multi-user/hosting forces Postgres — swap datasource, queries unchanged.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A caregiver ("ผู้ดูแล"). lineId is the LINE userId once LINE login is wired;
// until then it's the freeform code typed at /enter. One user cares for many
// ผู้รับการดูแล, and one ผู้รับการดูแล has many caregivers (implicit m-n).
model User {
  id          String    @id @default(cuid())
  lineId      String    @unique
  name        String?
  createdAt   DateTime  @default(now())
  patients    Patient[] // ผู้รับการดูแลที่ User นี้ช่วยดูแล
  selfPatient Patient?  @relation("UserSelf") // โปรไฟล์ตัวเอง (ถ้ามี) — ใช้เชิญคนมาดูแลเรา
}

model Patient {
  id             String        @id @default(cuid())
  inviteCode     String        @unique @default(cuid()) // shareable code — ญาติเปิด /join/<code> เพื่อมาช่วยดูแล
  name           String
  age            Int? // อายุ
  coverage       String? // สิทธิการรักษา (เช่น บัตรทอง)
  hospital       String? // โรงพยาบาลตามสิทธิ์
  job            String? // อาชีพ / อดีตอาชีพ
  likes          String? // สิ่งที่ชอบ
  caregiver      String? // คนดูแลหลัก (ชื่อที่โชว์เฉยๆ — คนละอย่างกับ caregivers ด้านล่าง)
  caregiverPhone String? // เบอร์โทรคนดูแลหลัก (ไม่มีถ้า login ผ่าน LINE — ปุ่มโทรจะซ่อนถ้าว่าง)
  diseases       String? // free text, "·"-separated in UI
  careGuide      String? // editable care instructions
  createdAt      DateTime      @default(now())
  // When set, this Patient row IS that User's own care record (เชิญคนมาดูแลเรา).
  selfOfUserId   String?       @unique
  selfOfUser     User?         @relation("UserSelf", fields: [selfOfUserId], references: [id])
  caregivers     User[] // ผู้ดูแล (m-n) — ผู้รับการดูแล 1 คนมีผู้ดูแลได้หลายคน
  weights        WeightLog[]
  meds           Medication[]
  allergies      Allergy[]
  appointments   Appointment[]
  visits         VisitNote[]
  observations   Observation[]
  careTasks      CareTask[]
  dailyChecks    DailyCheck[]
}

// A recurring daily to-do for the care calendar — the non-med categories
// (สุขภาพ = health tracking, ฟื้นฟู = rehab). ยา items come from Medication.
model CareTask {
  id        String   @id @default(cuid())
  patientId String
  category  String // "สุขภาพ" | "ฟื้นฟู"
  title     String
  time      String? // "HH:MM" — optional
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id])

  // One task title per category per patient — makes duplicate rows impossible
  // (a concurrent seed or a double-tapped "เพิ่ม" can't create a second copy).
  @@unique([patientId, category, title])
}

// One row = a calendar item ("med:<id>" | "task:<id>") was marked done on `date`
// (YYYY-MM-DD, Thai-local). Presence = done; toggling off deletes the row.
model DailyCheck {
  id        String  @id @default(cuid())
  patientId String
  itemKey   String
  date      String
  patient   Patient @relation(fields: [patientId], references: [id])

  @@unique([patientId, itemKey, date])
}

// A narrative observation the caregiver told, AI-organized into a category.
// The model categorizes only — it does not diagnose (AGENTS.md rule 2).
// Drug catalog — the pick-list for adding medications & allergies (no patient relation).
model Drug {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?
}

model Observation {
  id        String   @id @default(cuid())
  patientId String
  category  String // เช่น การกิน, การนอนและขับถ่าย
  text      String
  severity  Int? // 0-10 ความร้ายแรงที่ AI ประเมิน (จุดในเส้นเวลา)
  signs     String? // canonical danger/soft-sign tags ที่ LLM สกัด "·"-separated (union กับ keyword net — lib/risk.ts)
  at        DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model WeightLog {
  id        String   @id @default(cuid())
  patientId String
  kg        Float
  systolic  Int? // ความดันตัวบน
  diastolic Int? // ความดันตัวล่าง
  pulse     Int? // ชีพจร
  temp      Float? // อุณหภูมิ °C (NEWS2 — ดู lib/risk.ts)
  spo2      Int? // ออกซิเจนปลายนิ้ว % (NEWS2)
  note      String?
  at        DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Medication {
  id        String  @id @default(cuid())
  patientId String
  name      String
  dose      Float? // ครั้งละ (เม็ด)
  perDay    Int? // วันละ (ครั้ง)
  whenTime  String? // ช่วงเวลา เช่น หลังอาหารเช้า
  remaining Int? // จำนวนที่เหลือ (เม็ด)
  schedule  String?
  patient   Patient @relation(fields: [patientId], references: [id])
}

model Allergy {
  id        String  @id @default(cuid())
  patientId String
  name      String
  patient   Patient @relation(fields: [patientId], references: [id])
}

model Appointment {
  id        String   @id @default(cuid())
  patientId String
  at        DateTime
  place     String? // โรงพยาบาลหรือสถานที่
  note      String?
  done      Boolean  @default(false)
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model VisitNote {
  id              String   @id @default(cuid())
  patientId       String
  symptom         String?
  medsReceived    String?
  nextAppointment String?
  at              DateTime @default(now())
  patient         Patient  @relation(fields: [patientId], references: [id])
}

// --- Health-rights knowledge base (reference/lookup data, seeded from the
// Health-Navigator spreadsheet). No Patient relations — these are static tables.
// Eligibility is decided deterministically in lib/rights.ts, never by the LLM. ---

model HealthRight {
  id            String @id // R001…
  name          String
  eligibleUsers String
  facility      String
  monthlyCost   String
  coverageLevel String
}

model Service {
  id       String @id // S001…
  name     String
  category String
}

model Agency {
  id             String @id // A001…
  name           String
  responsibility String
}

model Facility {
  id       String @id // F001…
  code     String
  name     String
  district String
  type     String
  lat      Float?
  lng      Float?
}

// The deterministic engine: (right + age + condition) → service, facility, category.
model RecommendationRule {
  id          Int    @id @default(autoincrement())
  serviceName String
  right       String // "ทุกสิทธิ" | "บัตรทอง" | …
  facility    String
  condition   String // free Thai text, parsed in lib/rights.ts
  category    String
}

model RequiredDoc {
  id      Int    @id @default(autoincrement())
  service String
  docs    String
}
