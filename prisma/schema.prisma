// Mor Num Thang — data model. See PLAN.md §3.
// ponytail: SQLite until multi-user/hosting forces Postgres — swap datasource, queries unchanged.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id           String        @id @default(cuid())
  owner        String        @default("demo") // ponytail: freeform owner id (the "login") — no auth yet
  name         String
  age          Int? // อายุ
  coverage     String? // สิทธิการรักษา (เช่น บัตรทอง)
  hospital     String? // โรงพยาบาลตามสิทธิ์
  job          String? // อาชีพ / อดีตอาชีพ
  likes        String? // สิ่งที่ชอบ
  caregiver    String? // คนดูแลหลัก
  diseases     String? // free text, "·"-separated in UI
  careGuide    String? // editable care instructions
  createdAt    DateTime      @default(now())
  weights      WeightLog[]
  meds         Medication[]
  allergies    Allergy[]
  appointments Appointment[]
  visits       VisitNote[]
  observations Observation[]

  @@index([owner])
}

// A narrative observation the caregiver told, AI-organized into a category.
// The model categorizes only — it does not diagnose (AGENTS.md rule 2).
// Drug catalog — the pick-list for adding medications & allergies (no patient relation).
model Drug {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?
}

model Observation {
  id        String   @id @default(cuid())
  patientId String
  category  String // เช่น การกิน, การนอนและขับถ่าย
  text      String
  severity  Int? // 0-10 ความร้ายแรงที่ AI ประเมิน (จุดในเส้นเวลา)
  at        DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model WeightLog {
  id        String   @id @default(cuid())
  patientId String
  kg        Float
  systolic  Int? // ความดันตัวบน
  diastolic Int? // ความดันตัวล่าง
  pulse     Int? // ชีพจร
  note      String?
  at        DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Medication {
  id        String  @id @default(cuid())
  patientId String
  name      String
  dose      Float? // ครั้งละ (เม็ด)
  perDay    Int? // วันละ (ครั้ง)
  whenTime  String? // ช่วงเวลา เช่น หลังอาหารเช้า
  remaining Int? // จำนวนที่เหลือ (เม็ด)
  schedule  String?
  patient   Patient @relation(fields: [patientId], references: [id])
}

model Allergy {
  id        String  @id @default(cuid())
  patientId String
  name      String
  patient   Patient @relation(fields: [patientId], references: [id])
}

model Appointment {
  id        String   @id @default(cuid())
  patientId String
  at        DateTime
  place     String? // โรงพยาบาลหรือสถานที่
  note      String?
  done      Boolean  @default(false)
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model VisitNote {
  id              String   @id @default(cuid())
  patientId       String
  symptom         String?
  medsReceived    String?
  nextAppointment String?
  at              DateTime @default(now())
  patient         Patient  @relation(fields: [patientId], references: [id])
}

// --- Health-rights knowledge base (reference/lookup data, seeded from the
// Health-Navigator spreadsheet). No Patient relations — these are static tables.
// Eligibility is decided deterministically in lib/rights.ts, never by the LLM. ---

model HealthRight {
  id            String @id // R001…
  name          String
  eligibleUsers String
  facility      String
  monthlyCost   String
  coverageLevel String
}

model Service {
  id       String @id // S001…
  name     String
  category String
}

model Agency {
  id             String @id // A001…
  name           String
  responsibility String
}

model Facility {
  id       String @id // F001…
  code     String
  name     String
  district String
  type     String
  lat      Float?
  lng      Float?
}

// The deterministic engine: (right + age + condition) → service, facility, category.
model RecommendationRule {
  id          Int    @id @default(autoincrement())
  serviceName String
  right       String // "ทุกสิทธิ" | "บัตรทอง" | …
  facility    String
  condition   String // free Thai text, parsed in lib/rights.ts
  category    String
}

model RequiredDoc {
  id      Int    @id @default(autoincrement())
  service String
  docs    String
}
