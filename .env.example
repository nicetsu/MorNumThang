# Copy this file to .env and fill in real values. .env itself is gitignored — never commit it.

# Database configuration
DATABASE_URL="file:./dev.db"

# AI Model configuration (Server-side only — see AGENTS.md rule 1)
# Points at an OpenAI-compatible endpoint. Ollama running locally works out of the box.
AI_BASE_URL="http://localhost:11434/v1"
AI_MODEL="llama3.2:latest"
AI_API_KEY="mock-api-key"

# Drug-label / appointment-slip scan: a vision model reads the photo directly (no sidecar).
# Its own OpenAI-compatible endpoint — e.g. NVIDIA's hosted API — so it can differ from AI_MODEL.
# Falls back to AI_BASE_URL / AI_API_KEY if OCR_BASE_URL / OCR_API_KEY are unset.
OCR_BASE_URL="https://integrate.api.nvidia.com/v1"
OCR_API_KEY="nvapi-xxxxx"
OCR_VISION_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
