# Copy this file to .env and fill in real values. .env itself is gitignored — never commit it.

# --- Database (required) ---
# Supabase Postgres. Local dev + migrations use the session pooler URL here; on Vercel,
# lib/db.ts falls back to Supabase's managed POSTGRES_PRISMA_URL (transaction pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- AI (server-side only — see AGENTS.md rule 1) ---
# Two independent lanes, each picking a preset from lib/ai.ts: thaillm | zai | nvidia.

# TEXT lane — Thai summaries/organize (required for summary, signals, care guide, rights advice).
AI_PROVIDER="thaillm"
THAILLM_API_KEY="xxxxx"

# VISION lane — photo OCR of drug labels / appointment slips (needs a multimodal model).
VISION_PROVIDER="zai"
ZAI_API_KEY="xxxxx"

# Optional per-value overrides — set these only to point a lane somewhere the presets don't cover.
# AI_BASE_URL=""
# AI_MODEL=""
# AI_API_KEY=""
# VISION_BASE_URL=""
# VISION_MODEL=""
# VISION_API_KEY=""
# NVIDIA_API_KEY=""   # only if AI_PROVIDER / VISION_PROVIDER = "nvidia"

# --- LINE (optional in dev: without these, /enter falls back to the code form — try "demo") ---
NEXT_PUBLIC_LIFF_ID="xxxxx-xxxxx"     # the only value shipped to the client
LINE_LOGIN_CHANNEL_ID="xxxxx"         # verifies the LIFF id_token
LINE_CHANNEL_ACCESS_TOKEN="xxxxx"     # push reminders + switching the rich menu
LINE_RICHMENU_MEMBER="richmenu-xxxxx" # rich menu applied after login

# Protects /api/cron/reminders (vercel.json crons). Unset = the route is open — set it in production.
CRON_SECRET="xxxxx"
