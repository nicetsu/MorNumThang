# Copy this file to .env and fill in real values. .env itself is gitignored — never commit it.

# Database configuration
DATABASE_URL="file:./dev.db"

# AI Model configuration (Server-side only — see AGENTS.md rule 1)
# Points at an OpenAI-compatible endpoint. Ollama running locally works out of the box.
AI_BASE_URL="http://localhost:11434/v1"
AI_MODEL="llama3.2:latest"
AI_API_KEY="mock-api-key"

# Drug-label / appointment-slip scan: OCR sidecar (ocr-service/, OpenCV + PaddleOCR) + the model
# that structures its raw text into fields. Start the sidecar with scripts/start-ocr.sh.
OCR_SERVICE_URL="http://localhost:8008"
OCR_STRUCTURE_MODEL="qwen2.5-coder:7b"
