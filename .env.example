# Copy this file to .env and fill in real values. .env itself is gitignored — never commit it.

# Database configuration
DATABASE_URL="file:./dev.db"

# AI Model configuration (server-side only — see AGENTS.md rule 1).
# The same multimodal model handles summaries, organization, drug labels, and appointment slips.
AI_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_MODEL="google/diffusiongemma-26b-a4b-it"
NVIDIA_API_KEY="nvapi-xxxxx"
