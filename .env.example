# Copy this file to .env and fill in real values. .env itself is gitignored — never commit it.

# Database configuration
DATABASE_URL="file:./dev.db"

# AI Model configuration (Server-side only — see AGENTS.md rule 1)
# Points at an OpenAI-compatible endpoint. Ollama running locally works out of the box.
AI_BASE_URL="http://localhost:11434/v1"
AI_MODEL="llama3.2:latest"
AI_API_KEY="mock-api-key"

# Drug-label / appointment-slip scan: a vision model on AI_BASE_URL reads the photo directly
# (no sidecar). Set to whatever vision model you've pulled, e.g. qwen2.5-vl:7b or llama3.2-vision.
OCR_VISION_MODEL="qwen2.5-vl:7b"
