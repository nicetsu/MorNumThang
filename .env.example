# Copy this file to .env and fill in real values. .env itself is gitignored — never commit it.

# --- Database (required) ---
# Supabase Postgres. Note the port differs by environment (docs/deployment.md trap #2):
#   :5432 = session pooler     — THIS FILE / local. Required by prisma migrate & db seed.
#   :6543 = transaction pooler — set this variant on Vercel. Survives serverless concurrency;
#                                5432 caps at 15 connections and 500s the whole site under load.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- AI (server-side only — see AGENTS.md rule 1) ---
# Two independent lanes, each picking a preset from lib/ai.ts: thaillm | zai | gemini | nvidia.

# TEXT lane — Thai summaries/organize (required for summary, signals, care guide, rights advice).
AI_PROVIDER="thaillm"
THAILLM_API_KEY="xxxxx"

# VISION lane — photo OCR of drug labels / appointment slips. Needs a multimodal model, so thaillm
# can never serve this lane. NOTE: no provider currently has a funded key — photo scanning is the
# one broken feature. See docs/deployment.md § สถานะ VISION for what each preset returned.
VISION_PROVIDER="zai"
ZAI_API_KEY="xxxxx"       # zai preset      — glm-4.5v
# GEMINI_API_KEY="xxxxx"  # gemini preset   — gemini-2.0-flash (Google OpenAI-compatible endpoint)
# NVIDIA_API_KEY="xxxxx"  # nvidia preset   — google/diffusiongemma-26b-a4b-it (also usable for TEXT)

# Optional per-value overrides — set these only to point a lane somewhere the presets don't cover.
# AI_BASE_URL=""
# AI_MODEL=""
# AI_API_KEY=""
# VISION_BASE_URL=""
# VISION_MODEL=""
# VISION_API_KEY=""

# --- LINE (optional in dev: without these, /enter falls back to the code form — try "demo") ---
NEXT_PUBLIC_LIFF_ID="xxxxx-xxxxx"     # the only value shipped to the client
LINE_LOGIN_CHANNEL_ID="xxxxx"         # verifies the LIFF id_token
LINE_CHANNEL_ACCESS_TOKEN="xxxxx"     # push reminders + switching the rich menu
LINE_RICHMENU_MEMBER="richmenu-xxxxx" # rich menu applied after login

# Protects /api/cron/reminders (vercel.json crons). Unset = the route is open — set it in production.
CRON_SECRET="xxxxx"
