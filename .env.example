# Copy this file to .env and fill in real values. .env itself is gitignored — never commit it.

# Database configuration
DATABASE_URL="file:./dev.db"

# AI configuration (server-side only — see AGENTS.md rule 1). Two lanes, see lib/ai.ts PRESETS.
# TEXT lane — Thai summaries/organize (thaillm/typhoon).
AI_PROVIDER="thaillm"
AI_MODEL="typhoon-s-thaillm-8b-instruct"
THAILLM_API_KEY="xxxxx"
# VISION lane — photo OCR of drug labels / appointment slips (zai/glm-4.5v, multimodal).
VISION_PROVIDER="zai"
ZAI_API_KEY="xxxxx"
